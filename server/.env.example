# Virasā Environment Variables
# Copy this file to .env and fill in your values
#     cp .env.example .env

# Server
PORT=3001
NODE_ENV=development

# Frontend origin(s) for CORS (comma-separated). Add your deployed domain.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Base URL for certificate QR codes and verification links (no trailing slash)
# Set to your public URL in production, e.g. https://virasa.example.com
BASE_URL=http://localhost:3001

# API Keys for write endpoints (comma-separated)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional service credentials for trusted non-browser clients. Browser writes
# use signed-in admin or artisan sessions; empty never enables anonymous writes.
API_KEYS=

# Rate limiting (window in ms, max requests per window)
RATE_WINDOW_MS=900000
RATE_MAX=200
WRITE_MAX=20
UPLOAD_MAX=30

# Database
# SQLite file path (default: kalachain.db in server folder)
DB_PATH=kalachain.db
# Uploaded media directory (default: uploads in server folder)
UPLOAD_DIR=uploads

# Authentication
# Demo accounts are created by seed.js. Production seeding refuses blank,
# short, or bundled demonstration passwords.
ADMIN_EMAIL=admin@virasa.in
ADMIN_PASSWORD=
ARTISAN_EMAIL=sunita@virasa.in
ARTISAN_PASSWORD=
# Key required to self-register an admin account via POST /api/auth/register (optional)
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SIGNUP_KEY=

# Production safety gate. Set this only when you intentionally want the bundled
# demonstration artisans and products created in a production container.
SEED_DEMO_DATA=false
